  {
    "id": "DS-TN-EDE-011",
    "ma_tu_lieu": "DS-TN-EDE-011",
    "la_du_lieu_minh_hoa": false,
    "ghi_chu_minh_hoa": "Nghi lễ chu toàn nghĩa vụ với người quá cố trong vòng đời của người Ê Đê.",
    "ten_di_san": "Nghi lễ bỏ mả của người Ê Đê",
    "ten_ban_dia": "Thi Hoa / Lễ Ma khô",
    "chu_giai_ten_ban_dia": "\"Thi Hoa\" là nghi thức bỏ mả, giải phóng linh hồn người chết về với thế giới tổ tiên và người sống chấm dứt tang chế.",
    "loai_hinh": "Tập quán xã hội",
    "dan_toc": "Người Ê Đê",
    "cong_dong_chu_the": "Cộng đồng Người Ê Đê (Anak Đê)",
    "vung_van_hoa": "Tây Nguyên",
    "tinh_thanh": "Tỉnh Đắk Lắk",
    "huyen_thi": "Huyện Cư M'gar & Huyện Buôn Đôn",
    "xa_phuong": "Xã Cư M'gar (Địa bàn khảo sát dự kiến)",
    "buon_lang": "Đang xác minh buôn/làng tại địa bàn khảo sát",
    "trang_thai_dia_ban": "Đang xác minh địa bàn",
    "dia_danh_hien_nay": "Các khu nhà mồ buôn làng tỉnh Đắk Lắk",
    "dia_danh_tu_lieu": "Tỉnh Đắk Lắk",
    "dia_danh_lich_su": "Khu vực nhà mồ rừng thiêng truyền thống Đắk Lắk",
    "mo_ta": "Lễ bỏ mả là nghi lễ trọng đại trong chu kỳ tang ma của người Ê Đê. Gia đình dựng ngôi nhà mồ mới kiên cố, tạc tượng gỗ trang trí xung quanh và làm lễ hiến tế trâu bò, dâng rượu cần tạ ơn. Sau lễ bỏ mả, người quá cố được tiễn về với Yang và đất mẹ, người sống kết thúc thời gian giữ mả để tái thiết lập cuộc sống bình thường.",
    "gia_tri_di_san": "Kết tinh nghệ thuật tạo hình tượng mồ dân gian, âm nhạc cồng chiêng tang lễ và quan niệm triết học sâu sắc về sự luân hồi của sự sống.",
    "lich_su_nguon_goc": "Bắt nguồn từ tín ngưỡng cổ xưa về thế giới bên kia của cư dân ngữ hệ Nam Đảo (Austronesian) tại Tây Nguyên.",
    "boi_canh_thuc_hanh": "Diễn ra tại khu nhà mồ buôn làng (M'sát) kéo dài từ 2 đến 3 ngày đêm.",
    "nghe_nhan_nguoi_thuc_hanh": [
      "Nghệ nhân tạc tượng nhà mồ và thầy cúng buôn làng tại Đắk Lắk"
    ],
    "nguoi_cung_cap": "Bảo tàng Đắk Lắk",
    "pham_vi_duoc_phep_su_dung": "Nghiên cứu nhân học văn hoá và mỹ thuật dân gian Tây Nguyên.",
    "tinh_trang_ghi_danh": "Trong danh mục kiểm kê di sản văn hoá phi vật thể tỉnh Đắk Lắk",
    "tinh_trang_bao_ton": "Quy mô tổ chức ngày nay được cộng đồng rút gọn đơn giản, tiết kiệm hơn để phù hợp với nếp sống văn hóa mới.",
    "hoat_dong_truyen_day": "Các nghệ nhân lớn tuổi chỉ dạy kỹ thuật đục mồ mây, tạc tượng và dựng hàng rào nhà mồ cho lớp trẻ.",
    "hinh_anh": "https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=1200&q=80",
    "am_thanh": "",
    "video": "",
    "nguon_tu_lieu": [
