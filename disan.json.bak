    "dia_danh_hien_nay": "Huyện Cư M'gar, Tỉnh Đắk Lắk",
    "dia_danh_tu_lieu": "Tỉnh Đắk Lắk",
    "dia_danh_lich_su": "Vùng đất người Ê Đê Đắk Lắk",
    "mo_ta": "Đinh Năm là loại khèn bầu truyền thống gồm sáu ống nứa ghép song song xuyên qua bầu khô được gắn bằng sáp ong rừng. Mỗi ống nứa có lưỡi gà bằng đồng hoặc cật nứa phát ra âm thanh da diết, trầm bổng, mô phỏng tiếng thì thầm tâm tình của lứa đôi và lời ru con bên bếp lửa nhà dài.",
    "gia_tri_di_san": "Đỉnh cao của sự sáng tạo nhạc cụ hơi dân gian từ nguyên liệu tre nứa nhiệt đới, gắn liền với tâm thức trữ tình của người Ê Đê.",
    "lich_su_nguon_goc": "Xuất hiện lâu đời trong đời sống nương rẫy, gắn liền với giai điệu dân ca dân nhạc Ê Đê cổ truyền.",
    "boi_canh_thuc_hanh": "Diễn tấu trong các đêm hát kể Khan, nghi lễ cúng thổi tai, đón bạn và ru con ngủ.",
    "nghe_nhan_nguoi_thuc_hanh": [
      "Nghệ nhân chế tác Đinh Năm buôn làng (Đang xác minh tại xã Cư M'gar)"
    ],
    "nguoi_cung_cap": "Sở Văn hoá, Thể thao và Du lịch tỉnh Đắk Lắk",
    "pham_vi_duoc_phep_su_dung": "Bảo tồn nhạc cụ truyền thống và nghiên cứu âm nhạc dân gian.",
    "tinh_trang_ghi_danh": "Kiểm kê di sản văn hoá phi vật thể tỉnh Đắk Lắk",
    "tinh_trang_bao_ton": "Kỹ thuật gắn sáp ong và tỉa lưỡi gà Đinh Năm đòi hỏi độ tinh tế cao, số nghệ nhân biết chế tác còn rất ít.",
    "hoat_dong_truyen_day": "Tổ chức các lớp dạy thổi và chế tác Đinh Năm cho thanh niên tại các nhà sinh hoạt cộng đồng buôn.",
    "hinh_anh": "https://images.unsplash.com/photo-1511192336575-5a79af67a629?auto=format&fit=crop&w=1200&q=80",
    "am_thanh": "",
    "video": "",
