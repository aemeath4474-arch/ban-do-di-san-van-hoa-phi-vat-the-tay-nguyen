  {
    "id": "DS-TN-EDE-014",
    "ma_tu_lieu": "DS-TN-EDE-014",
    "la_du_lieu_minh_hoa": false,
    "ghi_chu_minh_hoa": "Nghi lễ biểu thị lòng biết ơn với muông thú trung thành gắn bó với lịch sử cao nguyên.",
    "ten_di_san": "Lễ cúng sức khỏe cho voi và chủ nhà của người Ê Đê",
    "ten_ban_dia": "Lễ ngă yang mngei",
    "chu_giai_ten_ban_dia": "\"Ngă yang\" là cúng thần, \"mngei\" là cúng sức khỏe cầu an cho thành viên gia đình và loài voi nuôi.",
    "loai_hinh": "Lễ hội truyền thống",
    "dan_toc": "Người Ê Đê",
