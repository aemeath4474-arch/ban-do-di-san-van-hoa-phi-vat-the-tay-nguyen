    "tinh_thanh": "Tỉnh Đắk Lắk",
    "huyen_thi": "Huyện Buôn Đôn & Huyện Cư M'gar",
    "xa_phuong": "Xã Cư M'gar (Địa bàn khảo sát dự kiến)",
    "buon_lang": "Đang xác minh buôn/làng tại địa bàn khảo sát",
    "trang_thai_dia_ban": "Địa bàn khảo sát dự kiến",
    "dia_danh_hien_nay": "Huyện Buôn Đôn và các vùng có voi thuần dưỡng tại Đắk Lắk",
    "dia_danh_tu_lieu": "Tỉnh Đắk Lắk",
    "dia_danh_lich_su": "Vùng thuần dưỡng voi rừng Buôn Đôn - Đắk Lắk cổ",
    "mo_ta": "Người Ê Đê coi voi như thành viên trong đại gia đình. Lễ cúng sức khỏe cho voi được tổ chức trang nghiêm tại sân nhà dài hoặc dưới bóng cây rừng. Thầy cúng dâng lễ vật (gà, rượu cần, chỉ ngũ sắc), đọc lời khấn vần cầu xin Yang ban cho voi có đôi tai thính, bốn chân vững chãi như đá núi và giúp đỡ con người làm nương rẫy.",
    "gia_tri_di_san": "Minh chứng sống động cho mối quan hệ hòa hợp, nhân ái giữa con người và động vật hoang dã trong hệ sinh thái rừng nhiệt đới Tây Nguyên.",
    "lich_su_nguon_goc": "Gắn liền với truyền thống thuần dưỡng voi rừng nổi tiếng của người Ê Đê và M'nông Đắk Lắk từ nhiều thế kỷ trước.",
    "boi_canh_thuc_hanh": "Diễn ra vào dịp đầu năm hoặc trước các chuyến đi xa nương rẫy.",
    "nghe_nhan_nguoi_thuc_hanh": [
      "Các thầy cúng và nài voi (Gruk) lâu năm tại Đắk Lắk"
