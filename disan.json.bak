  {
    "id": "DS-TN-EDE-012",
    "ma_tu_lieu": "DS-TN-EDE-012",
    "la_du_lieu_minh_hoa": false,
    "ghi_chu_minh_hoa": "Nghề thủ công khéo léo của đàn ông Ê Đê sử dụng tre mây rừng.",
    "ten_di_san": "Nghề đan lát mây tre truyền thống của người Ê Đê",
    "ten_ban_dia": "Dơng sah, kpeh (Đan gùi, chiếu, nong, nia)",
    "chu_giai_ten_ban_dia": "\"Sah\" là đan lát, \"Kpeh\" là loại gùi có nắp đậy tinh xảo của người Ê Đê dùng đựng y phục quý và tư trang.",
    "loai_hinh": "Nghề thủ công truyền thống",
    "dan_toc": "Người Ê Đê",
    "cong_dong_chu_the": "Cộng đồng Người Ê Đê (Anak Đê)",
    "vung_van_hoa": "Tây Nguyên",
    "tinh_thanh": "Tỉnh Đắk Lắk",
    "huyen_thi": "Huyện Cư M'gar & Huyện Krông Búk",
    "xa_phuong": "Xã Cư M'gar (Địa bàn khảo sát dự kiến)",
    "buon_lang": "Đang xác minh buôn/làng tại địa bàn khảo sát",
    "trang_thai_dia_ban": "Đang xác minh địa bàn",
    "dia_danh_hien_nay": "Các buôn làng Huyện Cư M'gar, Tỉnh Đắk Lắk",
    "dia_danh_tu_lieu": "Tỉnh Đắk Lắk",
    "dia_danh_lich_su": "Vùng rừng tre nứa cao nguyên Đắk Lắk",
    "mo_ta": "Đan lát mây tre là nghề truyền thống của nam giới người Ê Đê. Từ các sợi mây rừng, giang, nứa được vót chuốt tỉ mỉ, người đàn ông đan thành các loại gùi (gùi có nắp Kpeh, gùi ba ngăn), chiếu tre Yêr, rổ, rá với các hoa văn xương cá, hoa văn mắt cáo đối xứng vừa bền chắc vừa mang tính mỹ thuật cao.",
    "gia_tri_di_san": "Thể hiện sự khéo léo, tri thức thích ứng với tự nhiên và đáp ứng trọn vẹn mọi nhu cầu lao động vận chuyển nương rẫy vùng cao.",
    "lich_su_nguon_goc": "Hình thành từ nhu cầu thực tiễn sinh tồn trong rừng sâu Tây Nguyên từ ngàn năm qua.",
    "boi_canh_thuc_hanh": "Đàn ông đan lát vào những ngày mưa rảnh việc dưới hiên nhà dài hoặc góc gian Gah.",
    "nghe_nhan_nguoi_thuc_hanh": [
      "Các nghệ nhân đan lát cao tuổi buôn làng tại Đắk Lắk"
    ],
    "nguoi_cung_cap": "Phòng Văn hoá - Thông tin Huyện Cư M'gar",
    "pham_vi_duoc_phep_su_dung": "Bảo tồn nghề thủ công truyền thống và hỗ trợ sinh kế cộng đồng.",
    "tinh_trang_ghi_danh": "Trong danh mục kiểm kê nghề thủ công truyền thống tỉnh Đắk Lắk",
    "tinh_trang_bao_ton": "Đang chịu sự cạnh tranh của đồ nhựa công nghiệp, cần hỗ trợ tiêu thụ và kết nối du lịch trải nghiệm.",
    "hoat_dong_truyen_day": "Mở các lớp dạy vót nan, đan gùi Kpeh cho nam thanh niên trong buôn tại các dịp nông nhàn.",
    "hinh_anh": "https://images.unsplash.com/photo-1584992236310-6edddc08acff?auto=format&fit=crop&w=1200&q=80",
