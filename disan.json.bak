    "ten_di_san": "Tri thức làm men lá và ủ rượu cần ché Tuk của người Ê Đê",
    "ten_ban_dia": "Kpiê ché Tuk / Ché Tang",
    "chu_giai_ten_ban_dia": "\"Kpiê\" là rượu cần, \"Ché Tuk\", \"Ché Tang\" là những loại ché cổ quý hiếm được xem là gia bảo của nhà dài Ê Đê.",
    "loai_hinh": "Tri thức dân gian",
    "dan_toc": "Người Ê Đê",
    "cong_dong_chu_the": "Cộng đồng Người Ê Đê (Anak Đê)",
    "vung_van_hoa": "Tây Nguyên",
    "tinh_thanh": "Tỉnh Đắk Lắk",
    "huyen_thi": "Huyện Cư M'gar & TP. Buôn Ma Thuột",
    "xa_phuong": "Xã Cư M'gar (Địa bàn khảo sát dự kiến)",
    "buon_lang": "Đang xác minh buôn/làng tại địa bàn khảo sát",
    "trang_thai_dia_ban": "Địa bàn khảo sát dự kiến",
    "dia_danh_hien_nay": "Toàn tỉnh Đắk Lắk (Địa bàn Cư M'gar có nhiều nghệ nhân giữ men)",
    "dia_danh_tu_lieu": "Tỉnh Đắk Lắk",
    "dia_danh_lich_su": "Vùng đất men lá nương rẫy Ê Đê Đắk Lắk",
    "mo_ta": "Rượu cần (Kpiê) người Ê Đê được làm từ gạo nếp nương, ngô, bo bo trộn cùng vỏ trấu và men lá cây rừng bí truyền. Men lá được giã từ rễ cây, vỏ cây rừng thơm ngọt tự nhiên. Rượu được ủ trong ché Tuk, ché Tang hàng tháng trời, khi uống cắm cần trúc (Cang) hút nước suối trong thơm ngát, nồng nàn vị núi rừng.",
    "gia_tri_di_san": "Vật phẩm kết nối con người với thần linh trong mọi nghi lễ và biểu tượng của sự thảo thơm, hiếu khách của chủ nhà dài.",
    "lich_su_nguon_goc": "Tri thức ẩm thực dân gian truyền đời của người phụ nữ Ê Đê.",
    "boi_canh_thuc_hanh": "Uống rượu cần bên bếp lửa nhà dài trong lễ cưới hỏi, lễ kết nghĩa, đón khách quý và ngày hội buôn làng.",
    "nghe_nhan_nguoi_thuc_hanh": [
      "Các nghệ nhân làm men lá truyền thống tại Huyện Cư M'gar"
    ],
    "nguoi_cung_cap": "Bảo tàng Đắk Lắk",
    "pham_vi_duoc_phep_su_dung": "Bảo tồn tri thức sinh thái dân tộc và phát triển sản phẩm văn hoá cộng đồng.",
    "tinh_trang_ghi_danh": "Trong danh mục kiểm kê tri thức dân gian ẩm thực tỉnh Đắk Lắk",
    "tinh_trang_bao_ton": "Được duy trì phổ biến trong đời sống buôn làng hiện nay.",
    "hoat_dong_truyen_day": "Các bà mẹ truyền dạy công thức nhận biết cây men rừng và kỹ thuật ủ ché cho con gái trong gia đình.",
