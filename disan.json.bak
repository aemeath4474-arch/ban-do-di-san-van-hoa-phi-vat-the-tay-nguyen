  {
    "id": "DS-TN-EDE-009",
    "ma_tu_lieu": "DS-TN-EDE-009",
    "la_du_lieu_minh_hoa": false,
    "ghi_chu_minh_hoa": "Hệ thống luật tục truyền khẩu bảo vệ xã hội mẫu hệ và trật tự buôn làng.",
    "ten_di_san": "Luật tục Ê Đê và tập quán xét xử mẫu hệ",
    "ten_ban_dia": "Klei phat kdi",
    "chu_giai_ten_ban_dia": "\"Klei phat kdi\" có nghĩa là lời phân xử việc, xét xử những hành vi vi phạm điều răn buôn làng bằng ngôn ngữ có vần điệu.",
    "loai_hinh": "Tập quán xã hội",
    "dan_toc": "Người Ê Đê",
    "cong_dong_chu_the": "Cộng đồng Người Ê Đê (Anak Đê)",
    "vung_van_hoa": "Tây Nguyên",
    "tinh_thanh": "Tỉnh Đắk Lắk",
    "huyen_thi": "Huyện Cư M'gar, Krông Ana, Buôn Đôn",
    "xa_phuong": "Xã Cư M'gar (Địa bàn khảo sát dự kiến)",
    "buon_lang": "Đang xác minh buôn/làng tại địa bàn khảo sát",
    "trang_thai_dia_ban": "Địa bàn khảo sát dự kiến",
    "dia_danh_hien_nay": "Toàn tỉnh Đắk Lắk (Địa bàn Cư M'gar khảo sát sâu)",
    "dia_danh_tu_lieu": "Tỉnh Đắk Lắk",
    "dia_danh_lich_su": "Vùng đất luật tục các buôn Ê Đê cổ",
    "mo_ta": "Luật tục Ê Đê (Klei phat kdi) gồm hàng trăm điều răn được đúc kết thành lời nói vần dễ nhớ, dễ truyền miệng. Luật tục phân xử nghiêm minh các tội xâm phạm chế độ mẫu hệ, xâm phạm rừng thiêng nguồn nước, tội trộm cắp và các hành vi làm mất đoàn kết buôn làng, lấy hòa giải và giáo dục làm mục tiêu chính.",
    "gia_tri_di_san": "Di sản pháp lý dân gian đặc sắc, kết tinh đạo đức, triết lý sống hòa hợp thiên nhiên và chuẩn mực xã hội mẫu hệ nhân văn.",
    "lich_su_nguon_goc": "Hình thành cùng sự ra đời của tổ chức buôn làng mẫu hệ Ê Đê, lưu truyền qua nhiều đời già làng và chủ buôn (Khoa buôn).",
    "boi_canh_thuc_hanh": "Thực hành trong các phiên xử kdi tại gian Gah nhà dài trước sự chứng kiến của già làng và bà con buôn xóm.",
    "nghe_nhan_nguoi_thuc_hanh": [
      "Các già làng, người am hiểu luật tục (Khoa buôn) tại Đắk Lắk"
    ],
    "nguoi_cung_cap": "Viện Nghiên cứu Văn hoá - Viện Hàn lâm KHXH Việt Nam",
    "pham_vi_duoc_phep_su_dung": "Nghiên cứu dân tộc học pháp luật và xây dựng hương ước buôn làng hiện đại.",
    "tinh_trang_ghi_danh": "Di sản tư liệu và tập quán xã hội được ghi nhận kiểm kê cấp tỉnh",
    "tinh_trang_bao_ton": "Hiện nay luật tục được tích hợp hài hòa vào hương ước, quy ước buôn làng để giải quyết hòa giải cơ sở.",
    "hoat_dong_truyen_day": "Già làng kể lại và răn dạy con cháu trong các buổi sinh hoạt dòng họ mẫu hệ bên bếp lửa nhà dài.",
    "hinh_anh": "https://images.unsplash.com/photo-1455390582262-044cdead277a?auto=format&fit=crop&w=1200&q=80",
    "am_thanh": "",
    "video": "",
    "nguon_tu_lieu": [
      {
        "ten_tai_lieu": "Luật tục Êđê - Lời nói vần trong xét xử và đời sống cộng đồng",
        "don_vi_cung_cap": "Viện Nghiên cứu Văn hoá Dân gian",
        "tac_gia_nguoi_ghi_nhan": "GS. Ngô Đức Thịnh, Chu Thái Sơn",
        "nam_cong_bo": "1996",
        "loai_nguon": "Nghiên cứu",
        "duong_dan": "NXB Văn hoá Dân tộc, Hà Nội"
      }
