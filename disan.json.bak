  {
    "id": "DS-TN-EDE-015",
    "ma_tu_lieu": "DS-TN-EDE-015",
    "la_du_lieu_minh_hoa": false,
    "ghi_chu_minh_hoa": "Nghệ thuật tạo hình dân gian mộc mạc thể hiện triết lý sinh sôi nảy nở.",
