  {
    "id": "DS-TN-EDE-010",
    "ma_tu_lieu": "DS-TN-EDE-010",
    "la_du_lieu_minh_hoa": false,
    "ghi_chu_minh_hoa": "Phong tục hôn nhân mẫu hệ thể hiện sự chăm sóc gia đình và cố kết dòng tộc.",
    "ten_di_san": "Tục nối dây trong hôn nhân gia đình của người Ê Đê",
    "ten_ban_dia": "Chuê nuê (Tục nối dây mẫu hệ)",
    "chu_giai_ten_ban_dia": "\"Chuê nuê\" nghĩa là nối dây dòng tộc. Khi người chồng hoặc người vợ qua đời, dòng họ người mất sẽ gả một người em kế vị để cùng nuôi dưỡng con cái.",
    "loai_hinh": "Tập quán xã hội",
    "dan_toc": "Người Ê Đê",
    "cong_dong_chu_the": "Cộng đồng Người Ê Đê (Anak Đê)",
    "vung_van_hoa": "Tây Nguyên",
    "tinh_thanh": "Tỉnh Đắk Lắk",
    "huyen_thi": "Huyện Cư M'gar & Huyện Krông Ana",
    "xa_phuong": "Xã Cư M'gar (Địa bàn khảo sát dự kiến)",
    "buon_lang": "Đang xác minh buôn/làng tại địa bàn khảo sát",
    "trang_thai_dia_ban": "Địa bàn khảo sát dự kiến",
    "dia_danh_hien_nay": "Tỉnh Đắk Lắk (Đang khảo sát sâu tại xã Cư M'gar)",
    "dia_danh_tu_lieu": "Tỉnh Đắk Lắk",
    "dia_danh_lich_su": "Vùng đồng bào Ê Đê Kpă, Adham Đắk Lắk",
    "mo_ta": "Tục Chuê nuê là nét tập quán đặc sắc nhằm bảo đảm quyền lợi nuôi dạy con trẻ và giữ gìn của cải dòng họ không bị phân tán. Ngày nay, tục nối dây được thực hiện trên nguyên tắc hoàn toàn tự nguyện, tôn trọng luật hôn nhân và sự đồng thuận của hai gia đình.",
    "gia_tri_di_san": "Thể hiện tình thương trách nhiệm đối với con cái mồ côi và tinh thần đoàn kết keo sơn giữa hai dòng họ thông gia.",
    "lich_su_nguon_goc": "Gắn liền với định chế gia đình mẫu hệ cổ xưa của người Ê Đê.",
    "boi_canh_thuc_hanh": "Diễn ra tại nhà dài sau khi mãn tang, có sự chứng kiến và thỏa thuận của người đại diện hai dòng họ (Đăm Khau).",
    "nghe_nhan_nguoi_thuc_hanh": [
      "Các vị Đăm Khau và người lớn tuổi trong dòng họ mẫu hệ Ê Đê"
    ],
    "nguoi_cung_cap": "Sở Văn hoá, Thể thao và Du lịch tỉnh Đắk Lắk",
    "pham_vi_duoc_phep_su_dung": "Nghiên cứu nhân học gia đình và phong tục tập quán truyền thống.",
    "tinh_trang_ghi_danh": "Trong danh mục kiểm kê phong tục tập quán các dân tộc thiểu số Đắk Lắk",
    "tinh_trang_bao_ton": "Đã có sự chuyển biến tiến bộ, phù hợp với đời sống văn minh hiện đại nhưng vẫn giữ được giá trị nghĩa tình.",
    "hoat_dong_truyen_day": "Giáo dục con cháu về đạo nghĩa vợ chồng và trách nhiệm phụng dưỡng cha mẹ, bảo bọc con cháu.",
    "hinh_anh": "https://images.unsplash.com/photo-1544717305-2782549b5136?auto=format&fit=crop&w=1200&q=80",
    "am_thanh": "",
    "video": "",
